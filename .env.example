# ==============================================================================
# VERITAS AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your API credentials if available.
# Veritas AI operates fully with local deterministic engines if keys are omitted.
# ==============================================================================

# Google Gemini API Key (Optional)
# Used for advanced conversational legal assistance and clause redrafting.
# If left blank, the platform executes deterministic, grounded contextual retrieval.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# TinyFish Agentic Web Investigation API Key (Optional)
# Used by autonomous browser agents to verify entity standing against MCA, SEC, and web registries.
# If left blank, the platform automatically activates transparent, labeled simulated registry results.
TINYFISH_API_KEY=""

# Maximum upload file size in Megabytes (Default: 25)
MAX_UPLOAD_SIZE_MB=25
